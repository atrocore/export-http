[
  {
    "key": "write",
    "action": "upsert",
    "entity": "product",
    "payload": [
      {% for entity in entities %}
      {
        "id": "{{ entity.id | shopware6Uuid }}",
        "name": "{{ entity.name }}",
        "productNumber": "{{ entity.sku }}",
        "description": "{{ entity.longDescription | raw }}",
        "stock": {{ entity.amount }},
        "active": {{ entity.isActive ? 'true' : 'false' }},
        "taxId": "a2ba309d85eb4c70ac64f06e8d6b7f5c",
        "featureSetId": "dabceb16429a49fd9c225328d606ded5",
        "properties": [
          {% for pav in entity.productAttributeValues %}
            {% if pav.language == 'main' %}
              {% set optionId = shopware6CreatePropertyOptionId(pav.id,'62fdec81582e228f4') %}
              {% if optionId != null %}{"id": "{{ optionId }}"},{% endif %}
            {% endif %}
          {% endfor %}
        ],
        {% set mainImageId = null %}
        "media": [
          {% set position = 1 %}
          {% for asset in entity.assets %}
            {% if asset | isImage %}
              {% if asset.channel == '' or asset.channel == '62fdec81582e228f4' %}
                {
                  "id": "{{ (entity.id ~ '_' ~ asset.id) | shopware6Uuid }}",
                  "mediaId": "{{ asset.id | shopware6UploadMedia}}",
                  "position": {{ position }}
                },
                {% set position = position + 1 %}
                {% if asset.isMainImage == true and asset.channel == '' and mainImageId == null %}
                  {% set mainImageId = asset.id %}
                {% endif %}
                {% if asset.isMainImage == true and asset.channel == '62fdec81582e228f4' %}
                  {% set mainImageId = asset.id %}
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}
        ],
        {% if mainImageId == null %}
          "coverId": null,
        {% else %}
          "coverId": "{{ (entity.id ~ '_' ~ mainImageId) | shopware6Uuid }}",
        {% endif %}
        "price": [
          {% for productPrice in entity.productPrices %}
            {% if productPrice.priceProfileId == '62fdec779e68d2bea' and productPrice.priceCurrency == 'EUR' %}
            {
              "currencyId": "b7d2554b0ce847cd82f3ac9bd1c0dfca",
              "net": {{ (productPrice.price / 1.077) | round(5) }},
              "linked": true,
              "gross": {{ productPrice.price }}
            },
            {% endif %}
            {% if productPrice.priceProfileId == '62fdec779e68d2bea' and productPrice.priceCurrency == 'USD' %}
              {
              "currencyId": "f40bd92fdb694f06979d0c46c48cd2c3",
              "net": {{ (productPrice.price / 1.077) | round(5) }},
              "linked": true,
              "gross": {{ productPrice.price }}
              }
            {% endif %}
          {% endfor %}
        ]
      },
      {% endfor %}
    ]
  }
]