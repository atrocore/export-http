{% set channelId = '62fdec81582e228f4' %}
{% set priceProfileId = '62fdec779e68d2bea' %}
{% set salesChannelId = '454ca6eda8fc465bb9366dd5f47a36cb' %}
{% set cmsPageId = 'cee189cc7e7044c9ba2642b5e4700461' %}
{% set taxId = 'a2ba309d85eb4c70ac64f06e8d6b7f5c' %}
{% set language = 'main' %}
{% set currencies = [
    {
        'currency': 'EUR',
        'currencyId': 'b7d2554b0ce847cd82f3ac9bd1c0dfca',
    },
    {
        'currency': 'USD',
        'currencyId': 'f40bd92fdb694f06979d0c46c48cd2c3',
    }
] %}
{% set optionsIds = [] %}
{% set productMediaIds = [] %}
[
{
"key": "write",
"action": "upsert",
"entity": "product",
"payload": [
{% for entity in entities %}
    {% set productActive = 'false' %}
    {% if entity.isActive %}
        {% set productActive = 'true' %}
        {% for productChannel in entity.productChannels %}
            {% if productChannel.channelId == channelId %}
                {% set productActive = productChannel.isActive ? 'true' : 'false' %}
            {% endif %}
        {% endfor %}
    {% endif %}
    {
    "id": "{{ entity.id | shopware6Uuid }}",
    "name": "{{ entity.name }}",
    "productNumber": "{{ entity.ean }}",
    "description": "{{ entity.longDescription | escapeDoubleQuote | backslashNToBr | raw }}",
    "stock": {{ entity.amount }},
    "active": {{ productActive }},
    "taxId": "{{ taxId }}",
    "manufacturerId": "{{ shopware6UpsertManufacturer(entity.brandId) }}",
    "visibilities": [
    {
    "id": "{{ (entity.id ~ '_' ~ salesChannelId) | shopware6Uuid }}",
    "productId": "{{ entity.id | shopware6Uuid }}",
    "salesChannelId": "{{ salesChannelId }}",
    "visibility": 30
    }
    ],
    "categories": [
    {% for category in entity.categories %}
        {% set categoryId = shopware6UpsertCategory(category.id, channelId, cmsPageId, language) %}
        {% if categoryId != null %}{"id": "{{ categoryId }}"},{% endif %}
    {% endfor %}
    ],
    "properties": [
    {% for pav in entity.productAttributeValues %}
        {% if pav.language == 'main' %}
            {% set optionId = shopware6UpsertPropertyOption(pav.id, channelId, language) %}
            {% if optionId != null %}{"id": "{{ optionId }}"},{% set optionsIds = optionsIds | merge([optionId]) %}{% endif %}
        {% endif %}
    {% endfor %}
    ],
    {% set mainImageId = null %}
    "media": [
    {% set position = 1 %}
    {% for asset in entity.assets %}
        {% if asset | isImage %}
            {% if 'HR_' in asset.name and (asset.channel == '' or asset.channel == channelId) %}
                {% set mediaId = shopware6UploadMedia(asset.id) %}
                {% if mediaId != null %}
                    {% set productMediaId = (entity.id ~ '_' ~ asset.id) | shopware6Uuid %}
                    {% set productMediaIds = productMediaIds | merge([productMediaId]) %}
                    {
                    "id": "{{ productMediaId }}",
                    "mediaId": "{{ mediaId }}",
                    "position": {{ position }}
                    },
                    {% set position = position + 1 %}
                    {% if asset.isMainImage == true and asset.channel == '' and mainImageId == null %}
                        {% set mainImageId = asset.id %}
                    {% endif %}
                {% endif %}
                {% if asset.isMainImage == true and asset.channel == channelId %}
                    {% set mainImageId = asset.id %}
                {% endif %}
            {% endif %}
        {% endif %}
    {% endfor %}
    ],
    {% if mainImageId == null %}
        "coverId": null,
    {% else %}
        "coverId": "{{ (entity.id ~ '_' ~ mainImageId) | shopware6Uuid }}",
    {% endif %}
    "price": [
    {% for productPrice in entity.productPrices %}
        {% for curr in currencies %}
            {% if productPrice.priceProfileId == priceProfileId and productPrice.priceCurrency == curr.currency %}
                {
                "currencyId": "{{ curr.currencyId }}",
                "net": {{ (productPrice.price / 1.077) | round(5) }},
                "linked": true,
                "gross": {{ productPrice.price }}
                },
            {% endif %}
        {% endfor %}
    {% endfor %}
    ]
    },
{% endfor %}
]
},
{
"action":"delete",
"entity":"product_property",
"payload":[
{% for entity in entities %}
    {% for optionId in shopware6GetToDeleteOptions(entity, optionsIds) %}
        {"productId":"{{ entity.id | shopware6Uuid }}","optionId":"{{ optionId }}"},
    {% endfor %}
{% endfor %}
]
},
{
"action":"delete",
"entity":"product_media",
"payload":[
{% for entity in entities %}
    {% for productMediaId in shopware6GetToDeleteMedias(entity, productMediaIds) %}
        {"id":"{{ productMediaId }}"},
    {% endfor %}
{% endfor %}
]
}
]