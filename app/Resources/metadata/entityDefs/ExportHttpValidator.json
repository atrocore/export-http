{
  "fields": {
    "name": {
      "type": "varchar",
      "required": true
    },
    "validator": {
      "type": "text",
      "view": "views/fields/script",
      "default": "{#ResponseText: \"{{responseText}}\" httpCode: \"{{httpCode}}\"#}\n{% set success = true %}\n{{ success }}",
      "tooltip": true,
      "required": true
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "exportFeeds": {
      "type": "hasMany",
      "foreign": "exportHttpValidator",
      "entity": "ExportFeed"
    }
  },
  "collection": {
    "sortBy": "createdAt",
    "asc": true
  },
  "indexes": {
    "name": {
      "columns": [
        "name",
        "deleted"
      ]
    }
  }
}