{
  "fields": {
    "type": {
      "options": [
        "__APPEND__",
        "http",
        "httpPro"
      ]
    },
    "httpMethod": {
      "type": "enum",
      "options": [
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "GET"
      ],
      "default": "POST",
      "notStorable": true,
      "dataField": true,
      "prohibitedEmptyValue": true
    },
    "httpContentType": {
      "type": "enum",
      "options": [
        "JSON"
      ],
      "default": "JSON",
      "notStorable": true,
      "dataField": true,
      "prohibitedEmptyValue": true
    },
    "httpConnectionId": {
      "type": "varchar",
      "view": "export-http:views/export-feed/fields/http-connection",
      "notStorable": true,
      "dataField": true
    },
    "httpConnectionName": {
      "type": "varchar",
      "notStorable": true,
      "dataField": true
    },
    "httpUrl": {
      "type": "varchar",
      "notStorable": true,
      "dataField": true
    },
    "exportHttpHeaders": {
      "type": "linkMultiple",
      "layoutDetailDisabled": true,
      "layoutMassUpdateDisabled": true,
      "noLoad": true,
      "importDisabled": true
    },
    "exportHttpBody": {
      "type": "text",
      "notStorable": true,
      "dataField": true,
      "required": false,
      "default": "{{configurator}}"
    },
    "exportHttpMustacheBody": {
      "type": "text",
      "notStorable": true,
      "dataField": true,
      "required": false,
      "default": "{\n  \"siteUrl\": \"{{config.siteUrl}}\",\n  \"entities\": [{{#entities}}{{#.}}\n     {\n       \"name\": \"{{name}}\"\n    },\n    {{/.}}{{/entities}}]\n}",
      "tooltip": true
    }
  },
  "links": {
    "exportHttpHeaders": {
      "type": "hasMany",
      "foreign": "exportFeed",
      "entity": "ExportHttpHeader"
    }
  }
}
